{
  "$description": "mechcraft-hud — command-console HUD style. DTCG tokens. Single amber/cyan palette × dark/light. Primitive → semantic → component. Brand-neutral; no game assets.",
  "$themes": [
    "dark",
    "light"
  ],
  "color": {
    "$type": "color",
    "primitive": {
      "metal": {
        "950": "#070a0c",
        "900": "#0d1215",
        "850": "#141b1f",
        "800": "#0a0f12",
        "750": "#1f282d",
        "700": "#2a353a",
        "600": "#46545a",
        "500": "#6a7b7f",
        "hi": "#8a9a9c",
        "track": "#05090b"
      },
      "paper": {
        "ground": "#e7e4dc",
        "plate": "#eeeae1",
        "card": "#fbf8f1",
        "raised": "#e3dfd5",
        "line": "#b8b2a4",
        "line-strong": "#928b7e",
        "hi": "#fffdf7"
      },
      "accent": {
        "amber": {
          "dark": {
            "readable": "#f2a23b",
            "tone": "#f2a23b",
            "soft": "#8a4b1e",
            "line": "#b77733",
            "ink": "#1a0f05"
          },
          "light": {
            "readable": "#8a4a12",
            "tone": "#d9852c",
            "soft": "#a65f1e",
            "line": "#9b5a20",
            "ink": "#1a0f05"
          }
        }
      },
      "cyan": {
        "dark": "#63d4e4",
        "dark-deep": "#1e6672",
        "light": "#0e6672",
        "light-deep": "#0b4b55"
      },
      "status": {
        "dark": {
          "good": "#7bd88f",
          "warn": "#f2d85a",
          "bad": "#e45c50",
          "info": "#63d4e4",
          "n1": "#d0a6ff",
          "n2": "#ff8f8f",
          "n3": "#ffab6b",
          "n4": "#ffdc5c"
        },
        "light": {
          "good": "#047857",
          "warn": "#92400e",
          "bad": "#b91c1c",
          "info": "#0e6672",
          "n1": "#7e22ce",
          "n2": "#b91c1c",
          "n3": "#9a3412",
          "n4": "#854d0e"
        }
      }
    },
    "semantic": {
      "amber": {
        "dark": {
          "bg": "{color.primitive.metal.950}",
          "bg-2": "{color.primitive.metal.900}",
          "surface": "{color.primitive.metal.850}",
          "surface-card": "{color.primitive.metal.800}",
          "surface-2": "{color.primitive.metal.750}",
          "surface-3": "{color.primitive.metal.700}",
          "line": "{color.primitive.metal.600}",
          "line-2": "{color.primitive.metal.500}",
          "ink": "#dfe8e4",
          "ink-2": "#b2c0bc",
          "mut": "#7f918e",
          "acc": "{color.primitive.accent.amber.dark.readable}",
          "acc-tone": "{color.primitive.accent.amber.dark.tone}",
          "acc-soft": "{color.primitive.accent.amber.dark.soft}",
          "acc-line": "{color.primitive.accent.amber.dark.line}",
          "acc-ink": "{color.primitive.accent.amber.dark.ink}",
          "cyan": "{color.primitive.cyan.dark}",
          "good": "{color.primitive.status.dark.good}",
          "warn": "{color.primitive.status.dark.warn}",
          "bad": "{color.primitive.status.dark.bad}",
          "info": "{color.primitive.status.dark.info}"
        },
        "light": {
          "bg": "{color.primitive.paper.ground}",
          "bg-2": "#f2efe7",
          "surface": "{color.primitive.paper.plate}",
          "surface-card": "{color.primitive.paper.card}",
          "surface-2": "{color.primitive.paper.raised}",
          "surface-3": "#d8d3c7",
          "line": "{color.primitive.paper.line}",
          "line-2": "{color.primitive.paper.line-strong}",
          "ink": "#171b18",
          "ink-2": "#3f4742",
          "mut": "#6b746d",
          "acc": "{color.primitive.accent.amber.light.readable}",
          "acc-tone": "{color.primitive.accent.amber.light.tone}",
          "acc-soft": "{color.primitive.accent.amber.light.soft}",
          "acc-line": "{color.primitive.accent.amber.light.line}",
          "acc-ink": "{color.primitive.accent.amber.light.ink}",
          "cyan": "{color.primitive.cyan.light}",
          "good": "{color.primitive.status.light.good}",
          "warn": "{color.primitive.status.light.warn}",
          "bad": "{color.primitive.status.light.bad}",
          "info": "{color.primitive.status.light.info}"
        }
      }
    }
  },
  "shape": {
    "$type": "dimension",
    "radius-sm": {
      "$value": "3px"
    },
    "radius-md": {
      "$value": "4px"
    },
    "radius-lg": {
      "$value": "6px"
    },
    "border": {
      "$value": "1px"
    },
    "rail": {
      "$value": "2px"
    },
    "bar": {
      "$value": "7px"
    },
    "command-key": {
      "$value": "40px"
    }
  },
  "space": {
    "$type": "dimension",
    "s1": {
      "$value": "4px"
    },
    "s2": {
      "$value": "8px"
    },
    "s3": {
      "$value": "12px"
    },
    "s4": {
      "$value": "16px"
    },
    "s5": {
      "$value": "24px"
    },
    "s6": {
      "$value": "32px"
    },
    "s7": {
      "$value": "48px"
    }
  },
  "typography": {
    "family": {
      "display": {
        "$value": "'Saira Condensed', 'Arial Narrow', 'Roboto Condensed', system-ui, sans-serif"
      },
      "sans": {
        "$value": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
      },
      "mono": {
        "$value": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace"
      }
    },
    "size": {
      "body": {
        "$value": "14px"
      },
      "body-sm": {
        "$value": "12px"
      },
      "label": {
        "$value": "10px"
      },
      "label-sm": {
        "$value": "9px"
      },
      "h1": {
        "$value": "48px"
      },
      "h2": {
        "$value": "19px"
      },
      "stat": {
        "$value": "28px"
      }
    },
    "tracking": {
      "label": {
        "$value": "0.14em"
      },
      "title": {
        "$value": "0.05em"
      }
    }
  },
  "motion": {
    "$type": "duration",
    "dur": {
      "$value": "160ms"
    },
    "ease": {
      "$value": "cubic-bezier(.2,.7,.3,1)"
    }
  },
  "texture": {
    "$type": "custom",
    "grid-size": {
      "$value": "47px"
    },
    "grid-line": {
      "$value": "color-mix(in srgb, var(--cc-cyan) 7%, transparent)"
    },
    "metal-sheen": {
      "$value": "linear-gradient(180deg, rgba(255,255,255,.05), transparent 55%)"
    },
    "recess-shadow": {
      "$value": "inset 0 1px 4px rgba(0,0,0,.45)"
    }
  },
  "component": {
    "$description": "Card/command components. Use CSS variables for runtime mode changes.",
    "card": {
      "background": {
        "$value": "var(--surface-card)"
      },
      "border": {
        "$value": "1px solid var(--card-border)"
      },
      "border-hover": {
        "$value": "1px solid var(--acc)"
      },
      "shadow-hover": {
        "$value": "0 0 0 1px var(--acc), 0 14px 30px color-mix(in srgb, var(--acc) 17%, transparent)"
      },
      "title": {
        "$value": "var(--acc)"
      }
    },
    "screen": {
      "background": {
        "$value": "var(--surface-card)"
      },
      "border": {
        "$value": "1px solid var(--cc-bezel-2)"
      },
      "shadow": {
        "$value": "inset 0 1px 4px rgba(0,0,0,.45)"
      }
    },
    "command-bar": {
      "background": {
        "$value": "linear-gradient(180deg, var(--surface-2), var(--surface) 55%, var(--bg-2))"
      },
      "border": {
        "$value": "1px solid var(--cc-bezel)"
      },
      "position": {
        "$value": "sticky bottom"
      }
    }
  }
}
