{
  "$description": "neon-hud — sci-fi/tactical HUD style. DTCG tokens. Primitive → semantic. Project slots (accent/status) are intentionally abstract; host projects re-point them.",
  "$themes": ["dark", "light"],

  "color": {
    "$type": "color",
    "primitive": {
      "space": { "900": "#04070a", "800": "#070b0f", "700": "#0d1420", "600": "#111b2a", "500": "#162233", "400": "#1d2c40", "300": "#2a3f5a" },
      "mist":  { "50": "#fbfdff", "100": "#eef4f9", "200": "#e3ecf3", "300": "#cdd9e4", "400": "#b3c4d3" },
      "cyan":  { "300": "#7fd0e6", "400": "#3fd0e6", "500": "#1e7f93", "600": "#245c6b", "700": "#0f7f93", "800": "#0b5f70" },
      "ink":   { "dark": "#dbeaf5", "dark-2": "#9fb6cc", "mut-dark": "#6b8299", "light": "#0d1b26", "light-2": "#3c5163", "mut-light": "#6b8093" }
    },
    "semantic": {
      "dark": {
        "bg":          "{color.primitive.space.800}",
        "bg-2":        "{color.primitive.space.900}",
        "surface":     "{color.primitive.space.700}",
        "surface-2":   "{color.primitive.space.600}",
        "surface-3":   "{color.primitive.space.500}",
        "line":        "{color.primitive.space.400}",
        "line-2":      "{color.primitive.space.300}",
        "ink":         "{color.primitive.ink.dark}",
        "ink-2":       "{color.primitive.ink.dark-2}",
        "mut":         "{color.primitive.ink.mut-dark}",
        "chrome":      "{color.primitive.cyan.400}",
        "chrome-2":    "{color.primitive.cyan.500}",
        "chrome-line": "{color.primitive.cyan.600}"
      },
      "light": {
        "bg":          "{color.primitive.mist.100}",
        "bg-2":        "#e2eaf1",
        "surface":     "{color.primitive.mist.50}",
        "surface-2":   "{color.primitive.mist.100}",
        "surface-3":   "{color.primitive.mist.200}",
        "line":        "{color.primitive.mist.300}",
        "line-2":      "{color.primitive.mist.400}",
        "ink":         "{color.primitive.ink.light}",
        "ink-2":       "{color.primitive.ink.light-2}",
        "mut":         "{color.primitive.ink.mut-light}",
        "chrome":      "{color.primitive.cyan.700}",
        "chrome-2":    "{color.primitive.cyan.800}",
        "chrome-line": "{color.primitive.cyan.300}"
      }
    },
    "slots": {
      "$description": "PROJECT SLOTS — host fills. Defaults shown.",
      "accent":        "{color.semantic.dark.chrome}",
      "accent-soft":   "rgba(63, 208, 230, 0.14)",
      "accent-line":   "rgba(63, 208, 230, 0.45)",
      "accent-ink":    "#04121a",
      "good": "#34d399", "warn": "#f0b429", "bad": "#ef6a6a", "info": "#6ea8fe"
    }
  },

  "shape": {
    "$type": "custom",
    "clip-panel": { "$value": "polygon(0 10px, 10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%)", "$description": "sharp top-left + bottom-right clip" },
    "clip-btn":   { "$value": "polygon(0 6px, 6px 0, 100% 0, 100% 100%, 6px 100%, 0 calc(100% - 6px))" }
  },

  "radius": {
    "$type": "dimension",
    "sm": { "$value": "8px" }, "md": { "$value": "12px" }, "lg": { "$value": "16px" }, "full": { "$value": "999px" }
  },

  "space": {
    "$type": "dimension",
    "s1": { "$value": "4px" }, "s2": { "$value": "8px" }, "s3": { "$value": "12px" },
    "s4": { "$value": "16px" }, "s5": { "$value": "24px" }, "s6": { "$value": "32px" }, "s7": { "$value": "48px" }
  },

  "typography": {
    "$description": "HUD register: humanist sans for text, monospace for numbers/keys. Host supplies actual families.",
    "family": {
      "sans":    { "$value": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" },
      "mono":    { "$value": "ui-monospace, 'SF Mono', Menlo, Consolas, monospace" },
      "display": { "$value": "{typography.family.sans}" }
    },
    "size":   { "body": { "$value": "15px" }, "h": { "$value": "26px" }, "label": { "$value": "10.5px" } },
    "weight": { "body": { "$value": 650 }, "value": { "$value": 700 } },
    "tracking": { "label": { "$value": "0.12em" }, "heading": { "$value": "-0.02em" } }
  },

  "motion": {
    "$type": "duration",
    "dur":  { "$value": "160ms" },
    "ease": { "$value": "cubic-bezier(.2,.7,.3,1)" }
  },

  "texture": {
    "$description": "Scanline overlay for the HUD feel. Off in light mode.",
    "scanlines": { "$value": "repeating-linear-gradient(0deg, rgba(63,208,230,.045) 0 1px, transparent 1px 3px)" }
  },

  "ornament": {
    "$description": "Corner + emblem art for data-orn='art'. Paths relative to the style dir.",
    "corner": { "$value": "ornaments/corner.png" },
    "emblem": { "$value": "ornaments/emblem.png" }
  }
}
