{
  "$description": "soviet-hud — dense sci-fi/tactical HUD style with a Soviet constructivist twist. DTCG tokens (primitive → semantic). One chrome hue; accent variants crimson|purple × modes dark|light. Project slots (accent/status) are abstract; hosts re-point them.",
  "$themes": ["dark", "light"],
  "$accents": ["crimson", "purple"],

  "color": {
    "$type": "color",
    "primitive": {
      "coal":  { "900": "#080607", "800": "#0c0a0b", "700": "#161213", "600": "#1e1819", "500": "#262020", "400": "#3a3133", "300": "#4d4244" },
      "bone":  { "50": "#fbf8f2", "100": "#f2ede4", "200": "#efe8dc", "150": "#e8e1d4", "300": "#cfc4b2", "400": "#b8a996" },
      "ink":   { "dark": "#f2e9e4", "dark-2": "#c4b5ae", "mut-dark": "#8a7973", "light": "#1c1410", "light-2": "#4a3b33", "mut-light": "#7a6a5e" },
      "crimson": { "dark": "#d01733", "dark-2": "#8f0f22", "dark-line": "#5a1220", "light": "#a5122a", "light-2": "#7d0d20", "light-line": "#d99aa6" },
      "purple":  { "dark": "#6d4fb3", "dark-2": "#4a3580", "dark-line": "#35275a", "light": "#5a3f9e", "light-2": "#43307a", "light-line": "#b3a4d6" },
      "status":  { "good": "#3fb950", "warn": "#d8a52a", "bad": "#ef5f5f", "info": "#6ea8fe" }
    },
    "semantic": {
      "dark": {
        "bg":          "{color.primitive.coal.800}",
        "bg-2":        "{color.primitive.coal.900}",
        "surface":     "{color.primitive.coal.700}",
        "surface-2":   "{color.primitive.coal.600}",
        "surface-3":   "{color.primitive.coal.500}",
        "line":        "{color.primitive.coal.400}",
        "line-2":      "{color.primitive.coal.300}",
        "ink":         "{color.primitive.ink.dark}",
        "ink-2":       "{color.primitive.ink.dark-2}",
        "mut":         "{color.primitive.ink.mut-dark}",
        "chrome":      "{color.primitive.crimson.dark}",
        "chrome-2":    "{color.primitive.crimson.dark-2}",
        "chrome-line": "{color.primitive.crimson.dark-line}"
      },
      "light": {
        "bg":          "{color.primitive.bone.100}",
        "bg-2":        "{color.primitive.bone.150}",
        "surface":     "{color.primitive.bone.50}",
        "surface-2":   "{color.primitive.bone.200}",
        "surface-3":   "{color.primitive.bone.150}",
        "line":        "{color.primitive.bone.300}",
        "line-2":      "{color.primitive.bone.400}",
        "ink":         "{color.primitive.ink.light}",
        "ink-2":       "{color.primitive.ink.light-2}",
        "mut":         "{color.primitive.ink.mut-light}",
        "chrome":      "{color.primitive.crimson.light}",
        "chrome-2":    "{color.primitive.crimson.light-2}",
        "chrome-line": "{color.primitive.crimson.light-line}"
      }
    },
    "accent-variants": {
      "$description": "purple accent overrides; crimson is the default above.",
      "purple": {
        "dark":  { "chrome": "{color.primitive.purple.dark}", "chrome-2": "{color.primitive.purple.dark-2}", "chrome-line": "{color.primitive.purple.dark-line}" },
        "light": { "chrome": "{color.primitive.purple.light}", "chrome-2": "{color.primitive.purple.light-2}", "chrome-line": "{color.primitive.purple.light-line}" }
      }
    },
    "slots": {
      "$description": "PROJECT SLOTS — host fills. Defaults shown (crimson accent).",
      "accent":      "{color.semantic.dark.chrome}",
      "accent-soft": "rgba(208, 23, 51, 0.14)",
      "accent-line": "rgba(208, 23, 51, 0.45)",
      "accent-ink":  "#120003",
      "good": "{color.primitive.status.good}",
      "warn": "{color.primitive.status.warn}",
      "bad":  "{color.primitive.status.bad}",
      "info": "{color.primitive.status.info}"
    }
  },

  "shape": {
    "$type": "custom",
    "border-width": { "$value": "2px" },
    "clip-panel": { "$value": "polygon(0 10px, 10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%)", "$description": "sharp top-left + bottom-right clip" },
    "clip-btn":   { "$value": "polygon(0 6px, 6px 0, 100% 0, 100% 100%, 6px 100%, 0 calc(100% - 6px), 0 6px)" }
  },

  "radius": {
    "$type": "dimension",
    "sm": { "$value": "3px" }, "md": { "$value": "6px" }, "lg": { "$value": "10px" }, "full": { "$value": "999px" }
  },

  "space": {
    "$type": "dimension",
    "s1": { "$value": "4px" }, "s2": { "$value": "8px" }, "s3": { "$value": "12px" },
    "s4": { "$value": "16px" }, "s5": { "$value": "24px" }, "s6": { "$value": "32px" }, "s7": { "$value": "48px" }
  },

  "typography": {
    "$description": "HUD register: Russo One display, Play text, mono/tabular data. Host supplies actual families (OFL, not bundled).",
    "family": {
      "display": { "$value": "'Russo One', ui-sans-serif, system-ui, sans-serif" },
      "sans":    { "$value": "'Play', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif" },
      "mono":    { "$value": "ui-monospace, 'SF Mono', Menlo, Consolas, monospace" }
    },
    "size":   { "body": { "$value": "14.5px" }, "h": { "$value": "24px" }, "label": { "$value": "10.5px" } },
    "tracking": { "label": { "$value": "0.14em" }, "heading": { "$value": "0.16em" } }
  },

  "motion": {
    "$type": "duration",
    "dur":  { "$value": "160ms" },
    "ease": { "$value": "cubic-bezier(.2,.7,.3,1)" }
  },

  "texture": {
    "$description": "Scanlines (dark only) + constructivist diagonal stripes for the HUD feel.",
    "scanlines": { "$value": "repeating-linear-gradient(0deg, rgba(208,23,51,.06) 0 1px, transparent 1px 3px)" },
    "diagonal":  { "$value": "repeating-linear-gradient(-18deg, transparent 0 46px, rgba(208,23,51,.05) 46px 52px)" }
  },

  "ornament": {
    "$description": "SVG motif art for data-orn='art' (tinted by --chrome via CSS mask). Paths relative to the style dir.",
    "star":    { "$value": "ornaments/star.svg" },
    "chevron": { "$value": "ornaments/chevron.svg" }
  }
}
