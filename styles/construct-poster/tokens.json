{
  "$description": "construct-poster — flat, cell-shaded constructivist-poster web style. DTCG tokens. Primitive → semantic. Light + dark. Accents: orange (canonical) + violet (alt). Project slots (accent + status) are intentionally abstract; hosts re-point them.",
  "$themes": [
    "light",
    "dark"
  ],
  "$accents": [
    "orange",
    "violet"
  ],
  "color": {
    "$type": "color",
    "primitive": {
      "orange": {
        "900": "#b84300",
        "800": "#e8600a",
        "700": "#ff8c2e",
        "600": "#ffc078",
        "500": "#ffe4c4"
      },
      "violet": {
        "900": "#6b5b8a",
        "800": "#8578a8",
        "700": "#a49cc0",
        "600": "#cbc4dd",
        "500": "#efecf5"
      },
      "paper": {
        "100": "#fdf3e3",
        "200": "#f0dcc0",
        "300": "#ffe4c4"
      },
      "ink": {
        "900": "#1a0800",
        "800": "#2d1400",
        "400": "#7a5c44"
      },
      "paper-violet": {
        "100": "#f7f5fa",
        "200": "#e8e3f0",
        "300": "#efecf5"
      },
      "ink-violet": {
        "900": "#241d33",
        "800": "#3a3149",
        "400": "#655b78"
      },
      "status": {
        "good": "#2e7d32",
        "warn": "#f1c40f",
        "bad": "#c0392b",
        "info": "#1d5f8a",
        "gold": "#f1c40f"
      },
      "night-orange": {
        "bg": "#120b08",
        "bg-2": "#1a0e09",
        "surface": "#1c0f09",
        "surface-2": "#26140c",
        "surface-3": "#321a0e",
        "line": "#f4e3cb",
        "line-2": "#d8c3aa",
        "ink": "#f6e8d6",
        "ink-2": "#d8c3aa",
        "mut": "#a88d75",
        "cell-shadow": "#050201"
      },
      "night-violet": {
        "bg": "#110d16",
        "bg-2": "#18111f",
        "surface": "#1b1424",
        "surface-2": "#241a30",
        "surface-3": "#30233d",
        "line": "#efe4ff",
        "line-2": "#d3c1ec",
        "ink": "#f3ecfb",
        "ink-2": "#d3c1ec",
        "mut": "#a795c2",
        "cell-shadow": "#07040c"
      },
      "orange-dark": {
        "900": "#ffb066",
        "800": "#ff7a1a",
        "700": "#ffc08a",
        "600": "#6a3210",
        "500": "#2a1309"
      },
      "violet-dark": {
        "900": "#d8c8ff",
        "800": "#b8a6e0",
        "700": "#e7dcff",
        "600": "#4a3a66",
        "500": "#241b33"
      },
      "status-dark": {
        "good": "#7bd88f",
        "warn": "#f0c24b",
        "bad": "#ff8b7a",
        "info": "#8fc7ff",
        "gold": "#e6c15c"
      }
    },
    "semantic": {
      "orange": {
        "bg": "{color.primitive.paper.100}",
        "bg-2": "{color.primitive.paper.200}",
        "surface": "{color.primitive.paper.100}",
        "surface-2": "{color.primitive.paper.200}",
        "surface-3": "{color.primitive.paper.300}",
        "line": "{color.primitive.ink.900}",
        "line-2": "{color.primitive.ink.800}",
        "ink": "{color.primitive.ink.900}",
        "ink-2": "{color.primitive.ink.800}",
        "mut": "{color.primitive.ink.400}",
        "chrome": "{color.primitive.orange.800}",
        "chrome-2": "{color.primitive.orange.900}",
        "chrome-bright": "{color.primitive.orange.700}",
        "chrome-soft": "{color.primitive.orange.600}",
        "chrome-pale": "{color.primitive.orange.500}",
        "cell-shadow": "{color.primitive.ink.900}"
      },
      "violet": {
        "bg": "{color.primitive.paper-violet.100}",
        "bg-2": "{color.primitive.paper-violet.200}",
        "surface": "{color.primitive.paper-violet.100}",
        "surface-2": "{color.primitive.paper-violet.200}",
        "surface-3": "{color.primitive.paper-violet.300}",
        "line": "{color.primitive.ink-violet.900}",
        "line-2": "{color.primitive.ink-violet.800}",
        "ink": "{color.primitive.ink-violet.900}",
        "ink-2": "{color.primitive.ink-violet.800}",
        "mut": "{color.primitive.ink-violet.400}",
        "chrome": "{color.primitive.violet.800}",
        "chrome-2": "{color.primitive.violet.900}",
        "chrome-bright": "{color.primitive.violet.700}",
        "chrome-soft": "{color.primitive.violet.600}",
        "chrome-pale": "{color.primitive.violet.500}",
        "cell-shadow": "{color.primitive.ink-violet.900}"
      },
      "orange-dark": {
        "bg": "{color.primitive.night-orange.bg}",
        "bg-2": "{color.primitive.night-orange.bg-2}",
        "surface": "{color.primitive.night-orange.surface}",
        "surface-2": "{color.primitive.night-orange.surface-2}",
        "surface-3": "{color.primitive.night-orange.surface-3}",
        "line": "{color.primitive.night-orange.line}",
        "line-2": "{color.primitive.night-orange.line-2}",
        "ink": "{color.primitive.night-orange.ink}",
        "ink-2": "{color.primitive.night-orange.ink-2}",
        "mut": "{color.primitive.night-orange.mut}",
        "chrome": "{color.primitive.orange-dark.800}",
        "chrome-2": "{color.primitive.orange-dark.900}",
        "chrome-bright": "{color.primitive.orange-dark.700}",
        "chrome-soft": "{color.primitive.orange-dark.600}",
        "chrome-pale": "{color.primitive.orange-dark.500}",
        "cell-shadow": "{color.primitive.night-orange.cell-shadow}"
      },
      "violet-dark": {
        "bg": "{color.primitive.night-violet.bg}",
        "bg-2": "{color.primitive.night-violet.bg-2}",
        "surface": "{color.primitive.night-violet.surface}",
        "surface-2": "{color.primitive.night-violet.surface-2}",
        "surface-3": "{color.primitive.night-violet.surface-3}",
        "line": "{color.primitive.night-violet.line}",
        "line-2": "{color.primitive.night-violet.line-2}",
        "ink": "{color.primitive.night-violet.ink}",
        "ink-2": "{color.primitive.night-violet.ink-2}",
        "mut": "{color.primitive.night-violet.mut}",
        "chrome": "{color.primitive.violet-dark.800}",
        "chrome-2": "{color.primitive.violet-dark.900}",
        "chrome-bright": "{color.primitive.violet-dark.700}",
        "chrome-soft": "{color.primitive.violet-dark.600}",
        "chrome-pale": "{color.primitive.violet-dark.500}",
        "cell-shadow": "{color.primitive.night-violet.cell-shadow}"
      }
    },
    "slots": {
      "$description": "PROJECT SLOTS — host fills. Defaults shown (orange light). slots-dark mirrors the dark orange accent.",
      "accent": "{color.semantic.orange.chrome}",
      "accent-soft": "{color.semantic.orange.chrome-pale}",
      "accent-line": "{color.semantic.orange.chrome}",
      "accent-ink": "{color.semantic.orange.bg}",
      "good": "{color.primitive.status.good}",
      "warn": "{color.primitive.status.warn}",
      "bad": "{color.primitive.status.bad}",
      "info": "{color.primitive.status.info}"
    },
    "slots-dark": {
      "accent": "{color.semantic.orange-dark.chrome}",
      "accent-soft": "{color.semantic.orange-dark.chrome-pale}",
      "accent-line": "{color.semantic.orange-dark.chrome}",
      "accent-ink": "{color.semantic.orange-dark.bg}",
      "good": "{color.primitive.status-dark.good}",
      "warn": "{color.primitive.status-dark.warn}",
      "bad": "{color.primitive.status-dark.bad}",
      "info": "{color.primitive.status-dark.info}"
    }
  },
  "shape": {
    "$type": "custom",
    "border-width": {
      "$value": "2px"
    },
    "cell-shadow": {
      "$value": "4px",
      "$description": "sharp, un-blurred offset shadow — the signature"
    },
    "radius": {
      "sm": "3px",
      "md": "4px",
      "lg": "6px",
      "full": "999px"
    }
  },
  "space": {
    "$type": "dimension",
    "s1": {
      "$value": "4px"
    },
    "s2": {
      "$value": "8px"
    },
    "s3": {
      "$value": "12px"
    },
    "s4": {
      "$value": "16px"
    },
    "s5": {
      "$value": "24px"
    },
    "s6": {
      "$value": "32px"
    },
    "s7": {
      "$value": "48px"
    }
  },
  "typography": {
    "$description": "Poster register: Russo One for display, Play for text, monospace for data. Host supplies actual families (both OFL, not bundled).",
    "family": {
      "display": {
        "$value": "'Russo One', 'Arial Black', system-ui, sans-serif"
      },
      "sans": {
        "$value": "'Play', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif"
      },
      "mono": {
        "$value": "'Courier New', ui-monospace, monospace"
      }
    },
    "size": {
      "body": {
        "$value": "15px"
      },
      "h": {
        "$value": "32px"
      },
      "label": {
        "$value": "11px"
      }
    },
    "tracking": {
      "banner": {
        "$value": "6px"
      },
      "label": {
        "$value": "2px"
      },
      "panel": {
        "$value": "3px"
      }
    }
  },
  "motion": {
    "$type": "duration",
    "dur": {
      "$value": "100ms"
    },
    "ease": {
      "$value": "cubic-bezier(.2,.7,.3,1)"
    }
  },
  "texture": {
    "$description": "Constructivist diagonal stripe layer (very low opacity) + ring/triangle decorations.",
    "diagonal": {
      "$value": "repeating-linear-gradient(-18deg, transparent 0 38px, rgba(232,96,10,0.09) 38px 44px)"
    },
    "diagonal-dark": {
      "$value": "repeating-linear-gradient(-18deg, transparent 0 38px, rgba(255,122,26,0.07) 38px 44px)"
    }
  }
}
