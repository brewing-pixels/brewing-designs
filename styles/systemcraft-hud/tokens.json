{
  "$description": "systemcraft-hud — metallic operations HUD style. DTCG tokens, primitive → semantic. Dark-first, light variant, six accent presets. No game assets.",
  "$themes": ["dark", "light"],
  "$accentPresets": ["terran", "horde", "zerg", "protoss", "night-elf", "human"],

  "color": {
    "$type": "color",
    "primitive": {
      "metal": {
        "950": "#0f1317",
        "900": "#191e24",
        "850": "#1a2028",
        "800": "#20262e",
        "700": "#252c34",
        "650": "#2f3842",
        "600": "#39434f",
        "500": "#38434f",
        "450": "#4d5a68",
        "card-line": "#222a33"
      },
      "mist": {
        "50": "#fbfcfd",
        "100": "#f4f6f8",
        "200": "#f3f5f8",
        "300": "#e9edf1",
        "400": "#dfe4ea",
        "500": "#e6eaee",
        "600": "#c7d0d8",
        "700": "#a9b6c2",
        "line": "#d8e0e7",
        "track": "#e4e9ee"
      },
      "ink": {
        "dark": "#f2f7fb",
        "dark-2": "#d2dee8",
        "mut-dark": "#a7b8c6",
        "light": "#17212a",
        "light-2": "#3d4b57",
        "mut-light": "#566675"
      },
      "accent": {
        "terran": {
          "dark": {"readable": "#6fe3f2", "tone": "#6fe3f2", "soft": "#2e9cae", "line": "#478694", "ink": "#082026"},
          "light": {"readable": "#155e75", "tone": "#155e75", "soft": "#0f4a5c", "line": "#6d9aa8", "ink": "#ffffff"}
        },
        "horde": {
          "dark": {"readable": "#b6f34a", "tone": "#b6f34a", "soft": "#5f8f1f", "line": "#6f9b2e", "ink": "#142006"},
          "light": {"readable": "#3f6212", "tone": "#3f6212", "soft": "#2f4a0b", "line": "#8aa05a", "ink": "#ffffff"}
        },
        "zerg": {
          "dark": {"readable": "#c084fc", "tone": "#88409c", "soft": "#5e2a6e", "line": "#6b2f7d", "ink": "#ffffff"},
          "light": {"readable": "#88409c", "tone": "#88409c", "soft": "#6d2f7e", "line": "#a06bb0", "ink": "#ffffff"}
        },
        "protoss": {
          "dark": {"readable": "#f0cf78", "tone": "#d9b24c", "soft": "#8a6a1f", "line": "#b08b2e", "ink": "#1a1405"},
          "light": {"readable": "#7a5b12", "tone": "#c9a227", "soft": "#6b4f0f", "line": "#b08b2e", "ink": "#1a1405"}
        },
        "night-elf": {
          "dark": {"readable": "#7ef0bd", "tone": "#3ddc97", "soft": "#1f8a5d", "line": "#47b583", "ink": "#04140d"},
          "light": {"readable": "#0f6b45", "tone": "#1f7a52", "soft": "#0b5436", "line": "#4f9f7b", "ink": "#ffffff"}
        },
        "human": {
          "dark": {"readable": "#9db9ff", "tone": "#5b8cff", "soft": "#345bb0", "line": "#5279d0", "ink": "#071226"},
          "light": {"readable": "#2f4fa0", "tone": "#3f6fe0", "soft": "#25407f", "line": "#6b8ad0", "ink": "#ffffff"}
        }
      },
      "status": {
        "dark": {
          "good": "#57e6b2", "warn": "#ffce5c", "bad": "#ff8f8f", "info": "#93c4ff",
          "n1": "#d0a6ff", "n2": "#ff8f8f", "n3": "#ffab6b", "n4": "#ffdc5c"
        },
        "light": {
          "good": "#047857", "warn": "#92400e", "bad": "#b91c1c", "info": "#1d4ed8",
          "n1": "#7e22ce", "n2": "#b91c1c", "n3": "#9a3412", "n4": "#854d0e"
        }
      }
    },
    "semantic": {
      "dark": {
        "bg":          "{color.primitive.metal.900}",
        "bg-2":        "{color.primitive.metal.800}",
        "surface":     "{color.primitive.metal.700}",
        "surface-2":   "{color.primitive.metal.650}",
        "surface-3":   "{color.primitive.metal.600}",
        "surface-card":"{color.primitive.metal.950}",
        "card-line":   "{color.primitive.metal.card-line}",
        "card-track":  "{color.primitive.metal.850}",
        "card-bg-hover":"#141a20",
        "line":        "{color.primitive.metal.500}",
        "line-2":      "{color.primitive.metal.450}",
        "ink":         "{color.primitive.ink.dark}",
        "ink-2":       "{color.primitive.ink.dark-2}",
        "mut":         "{color.primitive.ink.mut-dark}",
        "acc":         "{color.primitive.accent.horde.dark.readable}",
        "acc-tone":    "{color.primitive.accent.horde.dark.tone}",
        "acc-soft":    "{color.primitive.accent.horde.dark.soft}",
        "acc-line":    "{color.primitive.accent.horde.dark.line}",
        "acc-ink":     "{color.primitive.accent.horde.dark.ink}",
        "good":        "{color.primitive.status.dark.good}",
        "warn":        "{color.primitive.status.dark.warn}",
        "bad":         "{color.primitive.status.dark.bad}",
        "info":        "{color.primitive.status.dark.info}",
        "n1":          "{color.primitive.status.dark.n1}",
        "n2":          "{color.primitive.status.dark.n2}",
        "n3":          "{color.primitive.status.dark.n3}",
        "n4":          "{color.primitive.status.dark.n4}"
      },
      "light": {
        "bg":          "{color.primitive.mist.500}",
        "bg-2":        "{color.primitive.mist.100}",
        "surface":     "{color.primitive.mist.200}",
        "surface-2":   "{color.primitive.mist.300}",
        "surface-3":   "{color.primitive.mist.400}",
        "surface-card":"{color.primitive.mist.50}",
        "card-line":   "{color.primitive.mist.line}",
        "card-track":  "{color.primitive.mist.track}",
        "card-bg-hover":"#f1f4f7",
        "line":        "{color.primitive.mist.600}",
        "line-2":      "{color.primitive.mist.700}",
        "ink":         "{color.primitive.ink.light}",
        "ink-2":       "{color.primitive.ink.light-2}",
        "mut":         "{color.primitive.ink.mut-light}",
        "acc":         "{color.primitive.accent.horde.light.readable}",
        "acc-tone":    "{color.primitive.accent.horde.light.tone}",
        "acc-soft":    "{color.primitive.accent.horde.light.soft}",
        "acc-line":    "{color.primitive.accent.horde.light.line}",
        "acc-ink":     "{color.primitive.accent.horde.light.ink}",
        "good":        "{color.primitive.status.light.good}",
        "warn":        "{color.primitive.status.light.warn}",
        "bad":         "{color.primitive.status.light.bad}",
        "info":        "{color.primitive.status.light.info}",
        "n1":          "{color.primitive.status.light.n1}",
        "n2":          "{color.primitive.status.light.n2}",
        "n3":          "{color.primitive.status.light.n3}",
        "n4":          "{color.primitive.status.light.n4}"
      }
    }
  },

  "texture": {
    "$type": "custom",
    "$description": "45° accent hatch: 21px gap / 22px line. 12% dark, 18% light. Decorative only.",
    "hatch-spacing": { "$value": "21px" },
    "hatch-stroke":  { "$value": "1px" },
    "hatch-dark":    { "$value": "repeating-linear-gradient(45deg, transparent 0 21px, color-mix(in srgb, var(--acc-tone) 12%, transparent) 21px 22px)" },
    "hatch-light":   { "$value": "repeating-linear-gradient(45deg, transparent 0 21px, color-mix(in srgb, var(--acc-tone) 18%, transparent) 21px 22px)" },
    "sheen-dark":    { "$value": "rgba(255,255,255,0.055)" },
    "sheen-light":   { "$value": "rgba(255,255,255,0.55)" }
  },

  "shape": {
    "$type": "dimension",
    "radius-sm": { "$value": "6px" },
    "radius-md": { "$value": "10px" },
    "radius-lg": { "$value": "12px" },
    "radius-full": { "$value": "999px" },
    "border": { "$value": "1px" },
    "border-strong": { "$value": "2px" },
    "bar": { "$value": "7px" }
  },

  "space": {
    "$type": "dimension",
    "s1": { "$value": "4px" },
    "s2": { "$value": "8px" },
    "s3": { "$value": "12px" },
    "s4": { "$value": "16px" },
    "s5": { "$value": "24px" },
    "s6": { "$value": "32px" },
    "s7": { "$value": "48px" }
  },

  "typography": {
    "$description": "System sans for UI/prose, mono for IDs/labels/numbers. Host supplies families.",
    "family": {
      "sans": { "$value": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" },
      "mono": { "$value": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace" },
      "display": { "$value": "{typography.family.sans}" }
    },
    "size": {
      "body": { "$value": "16px" },
      "body-sm": { "$value": "13px" },
      "label": { "$value": "10px" },
      "label-sm": { "$value": "9px" },
      "h1": { "$value": "38px" },
      "h2": { "$value": "18px" },
      "stat": { "$value": "26px" }
    },
    "weight": {
      "regular": { "$value": 400 },
      "medium": { "$value": 600 },
      "bold": { "$value": 650 },
      "stat": { "$value": 700 }
    },
    "tracking": {
      "label": { "$value": "0.12em" },
      "heading": { "$value": "-0.04em" }
    }
  },

  "motion": {
    "$type": "duration",
    "dur": { "$value": "160ms" },
    "ease": { "$value": "cubic-bezier(.2,.7,.3,1)" }
  }
}
