{
  "$description": "systemcraft-hud — hybrid systems HUD style. DTCG tokens. Mechcraft type/card geometry + Moderncraft texture/restraint on a darker black. Three colours in six role orders; Sahara/grid backgrounds; dark/light.",
  "$themes": [
    "dark",
    "light"
  ],
  "color": {
    "$type": "color",
    "primitive": {
      "neutral": {
        "dark": {
          "bg": "#05070a",
          "bg-2": "#080d11",
          "surface": "#0b1014",
          "surface-card": "#0a0f13",
          "surface-2": "#111a20",
          "surface-3": "#17232b",
          "line": "#22303a",
          "line-2": "#35464f",
          "card-line": "#17232a",
          "ink": "#eaf1ef",
          "ink-2": "#b9c7c2",
          "mut": "#7f918b"
        },
        "light": {
          "bg": "#e7eae7",
          "bg-2": "#f2f4f1",
          "surface": "#eef1ed",
          "surface-card": "#fbfcf9",
          "surface-2": "#e3e8e3",
          "surface-3": "#d6ddd7",
          "line": "#c1cbc3",
          "line-2": "#9fada4",
          "card-line": "#d4ddd5",
          "ink": "#131a16",
          "ink-2": "#3e4b44",
          "mut": "#5f6e65"
        }
      },
      "accent": {
        "amber": {
          "dark": {
            "readable": "#f2a23b",
            "fill": "#d9852c",
            "soft": "#8a4b1e",
            "line": "#b77733",
            "ink": "#1a0f05"
          },
          "light": {
            "readable": "#8a4a12",
            "fill": "#d9852c",
            "soft": "#a65f1e",
            "line": "#9b5a20",
            "ink": "#1a0f05"
          }
        },
        "cyan": {
          "dark": {
            "readable": "#63d4e4",
            "fill": "#2a9dac",
            "soft": "#1e6672",
            "line": "#2f7c86",
            "ink": "#04191c"
          },
          "light": {
            "readable": "#0e6672",
            "fill": "#2a9dac",
            "soft": "#0b4b55",
            "line": "#0f6672",
            "ink": "#04191c"
          }
        },
        "lime": {
          "dark": {
            "readable": "#b6f34a",
            "fill": "#84cc16",
            "soft": "#4f6b1f",
            "line": "#6f9b2e",
            "ink": "#0d1605"
          },
          "light": {
            "readable": "#3f6212",
            "fill": "#84cc16",
            "soft": "#4f6b1f",
            "line": "#6f8f3a",
            "ink": "#0d1605"
          }
        }
      },
      "status": {
        "dark": {
          "good": "#7bd88f",
          "warn": "#f2d85a",
          "bad": "#e45c50",
          "info": "#63d4e4",
          "n1": "#d0a6ff",
          "n2": "#ff8f8f",
          "n3": "#ffab6b",
          "n4": "#ffdc5c"
        },
        "light": {
          "good": "#047857",
          "warn": "#92400e",
          "bad": "#b91c1c",
          "info": "#0e6672",
          "n1": "#7e22ce",
          "n2": "#b91c1c",
          "n3": "#9a3412",
          "n4": "#854d0e"
        }
      }
    },
    "roles": {
      "amber-cyan-lime": {
        "prime": "amber",
        "secondary": "cyan",
        "tertiary": "lime"
      },
      "amber-lime-cyan": {
        "prime": "amber",
        "secondary": "lime",
        "tertiary": "cyan"
      },
      "cyan-amber-lime": {
        "prime": "cyan",
        "secondary": "amber",
        "tertiary": "lime"
      },
      "cyan-lime-amber": {
        "prime": "cyan",
        "secondary": "lime",
        "tertiary": "amber"
      },
      "lime-amber-cyan": {
        "prime": "lime",
        "secondary": "amber",
        "tertiary": "cyan"
      },
      "lime-cyan-amber": {
        "prime": "lime",
        "secondary": "cyan",
        "tertiary": "amber"
      }
    },
    "semantic": {
      "dark": {
        "bg": "{color.primitive.neutral.dark.bg}",
        "bg-2": "{color.primitive.neutral.dark.bg-2}",
        "surface": "{color.primitive.neutral.dark.surface}",
        "surface-card": "{color.primitive.neutral.dark.surface-card}",
        "surface-2": "{color.primitive.neutral.dark.surface-2}",
        "surface-3": "{color.primitive.neutral.dark.surface-3}",
        "line": "{color.primitive.neutral.dark.line}",
        "line-2": "{color.primitive.neutral.dark.line-2}",
        "card-line": "{color.primitive.neutral.dark.card-line}",
        "ink": "{color.primitive.neutral.dark.ink}",
        "ink-2": "{color.primitive.neutral.dark.ink-2}",
        "mut": "{color.primitive.neutral.dark.mut}",
        "good": "{color.primitive.status.dark.good}",
        "warn": "{color.primitive.status.dark.warn}",
        "bad": "{color.primitive.status.dark.bad}",
        "info": "{color.primitive.status.dark.info}"
      },
      "light": {
        "bg": "{color.primitive.neutral.light.bg}",
        "bg-2": "{color.primitive.neutral.light.bg-2}",
        "surface": "{color.primitive.neutral.light.surface}",
        "surface-card": "{color.primitive.neutral.light.surface-card}",
        "surface-2": "{color.primitive.neutral.light.surface-2}",
        "surface-3": "{color.primitive.neutral.light.surface-3}",
        "line": "{color.primitive.neutral.light.line}",
        "line-2": "{color.primitive.neutral.light.line-2}",
        "card-line": "{color.primitive.neutral.light.card-line}",
        "ink": "{color.primitive.neutral.light.ink}",
        "ink-2": "{color.primitive.neutral.light.ink-2}",
        "mut": "{color.primitive.neutral.light.mut}",
        "good": "{color.primitive.status.light.good}",
        "warn": "{color.primitive.status.light.warn}",
        "bad": "{color.primitive.status.light.bad}",
        "info": "{color.primitive.status.light.info}"
      }
    }
  },
  "shape": {
    "$type": "dimension",
    "radius-sm": {
      "$value": "3px"
    },
    "radius-md": {
      "$value": "4px"
    },
    "radius-lg": {
      "$value": "6px"
    },
    "border": {
      "$value": "1px"
    },
    "rail": {
      "$value": "1px"
    },
    "bar": {
      "$value": "6px"
    }
  },
  "space": {
    "$type": "dimension",
    "s1": {
      "$value": "4px"
    },
    "s2": {
      "$value": "8px"
    },
    "s3": {
      "$value": "12px"
    },
    "s4": {
      "$value": "16px"
    },
    "s5": {
      "$value": "24px"
    },
    "s6": {
      "$value": "32px"
    },
    "s7": {
      "$value": "48px"
    }
  },
  "typography": {
    "family": {
      "display": {
        "$value": "'Saira Condensed', 'Arial Narrow', 'Roboto Condensed', system-ui, sans-serif"
      },
      "sans": {
        "$value": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
      },
      "mono": {
        "$value": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace"
      }
    },
    "size": {
      "brand": {
        "$value": "30px"
      },
      "page-title": {
        "$value": "40px"
      },
      "section-title": {
        "$value": "12px"
      },
      "body": {
        "$value": "13px"
      },
      "meta": {
        "$value": "10px"
      },
      "mono": {
        "$value": "10px"
      }
    },
    "tracking": {
      "label": {
        "$value": "0.14em"
      },
      "nav": {
        "$value": "0.15em"
      }
    }
  },
  "motion": {
    "$type": "duration",
    "duration": {
      "$value": "160ms"
    },
    "ease": {
      "$value": "cubic-bezier(0.2, 0.7, 0.3, 1)"
    }
  },
  "texture": {
    "sahara": {
      "angle": {
        "$value": "45deg"
      },
      "pitch": {
        "$value": "21px"
      },
      "line": {
        "$value": "22px"
      },
      "opacity-dark": {
        "$value": "9%"
      },
      "opacity-light": {
        "$value": "14%"
      }
    },
    "grid": {
      "pitch": {
        "$value": "47px"
      },
      "line": {
        "$value": "48px"
      },
      "opacity-dark": {
        "$value": "7%"
      },
      "opacity-light": {
        "$value": "10%"
      }
    }
  },
  "component": {
    "card": {
      "background": "{color.semantic.dark.surface-card}",
      "border": "1px prime-tinted",
      "radius": "{shape.radius-sm}",
      "highlight": "inset 0 1px 0 ink @ 7%"
    },
    "masthead": {
      "divider": "1px solid {color.semantic.dark.line}",
      "layout": "brand | pages | actions"
    },
    "command-bar": {
      "radius": "{shape.radius-sm}",
      "background": "{color.semantic.dark.surface-card}"
    }
  }
}
